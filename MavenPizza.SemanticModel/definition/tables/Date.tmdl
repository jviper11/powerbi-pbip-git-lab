		lineageTag: fc13f8a8-969f-4eac-9969-f804eb0420a9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Weekday Number", WEEKDAY([Date], 2),   -- Monday = 1
				    "Weekday Name", FORMAT([Date], "dddd"),
				    "Is Weekend", IF(WEEKDAY([Date], 2) >= 6, TRUE(), FALSE())
				)
				
				
				```

	annotation PBI_Id = 111d2ef11e9e46d1a536efdfcd8b9b9b

